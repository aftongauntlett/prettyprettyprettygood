# Copy this file to .env and fill in your own values.
# .env is gitignored and should never be committed.

# Formspree — contact form endpoint ID
# Get yours at https://formspree.io
PUBLIC_FORMSPREE_ID=

# Ko-fi — support/donate link
# e.g. https://ko-fi.com/YOUR_ID
PUBLIC_KOFI_URL=

# Vercel — project ID
# Auto-injected by Vercel in production. Set here for local reference.
VERCEL_PROJECT_ID=
