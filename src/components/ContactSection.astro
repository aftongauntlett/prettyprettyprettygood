---
import { Send, Mail } from '@lucide/astro';
import StyledDropdown from './StyledDropdown.astro';
import BlueskyIcon from './icons/BlueskyIcon.astro';

const blueskyUrl = 'https://bsky.app/profile/prettyprettypretty.bsky.social';
const contactEmail = 'contact@prettyprettyprettygood.org';

interface Props {
  status?: 'sent' | 'error' | null;
}

const { status = null }: Props = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
---

<section class="section" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="eyebrow">start a project</p>
      <h2 id="contact-heading">Tell me what you're building.</h2>
      <p class="section-lead">
        Don't overthink it. A few sentences about who you are and what you need
        is plenty. If funding is tight, you can still request fully free work.
        If your org has a budget, you can opt into a sliding-scale contribution.
      </p>
    </div>

    <div class="contact-layout">
      <div class="contact-form-card" data-reveal>
        <form class="contact-form" action="/api/contact" method="POST" data-contact-form>
          <input type="hidden" name="form-started-at" value="" data-contact-started-at />
          <input type="hidden" name="cf-turnstile-response" value="" data-contact-turnstile-token />

          <div class="field field--honeypot" aria-hidden="true">
            <label class="field__label visually-hidden" for="project-url">Project URL</label>
            <input
              class="field__input"
              type="text"
              id="project-url"
              name="project-url"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          {
            status === 'error' && (
              <p class="contact-notice contact-notice--error" role="alert" aria-live="assertive" tabindex="-1" data-contact-notice="error">
                Something went wrong while sending your message. Please try again.
              </p>
            )
          }

          {
            status !== 'error' && (
              <p class="contact-notice contact-notice--error" role="alert" aria-live="assertive" tabindex="-1" data-contact-notice="error" hidden>
                Something went wrong while sending your message. Please try again.
              </p>
            )
          }

          <div class="field">
            <label class="field__label" for="name">Your name <span class="field__required" aria-hidden="true">*</span></label>
            <input class="field__input" type="text" id="name" name="name" placeholder="What should I call you?" autocomplete="name" required />
          </div>

          <div class="field">
            <label class="field__label" for="email">Email address <span class="field__required" aria-hidden="true">*</span></label>
            <input class="field__input" type="email" id="email" name="email" placeholder="Where should I write back?" autocomplete="email" required />
          </div>

          <div class="field">
            <label class="field__label" for="existing-site">Existing or desired website/domain <span class="field__required" aria-hidden="true">*</span></label>
            <input class="field__input" type="text" id="existing-site" name="existing-site" placeholder="https://yoursite.com, or just the domain you'd like" autocomplete="url" required />
          </div>

          <div class="field">
            <label class="field__label" for="message">Tell me about your work <span class="field__required" aria-hidden="true">*</span></label>
            <textarea
              class="field__input field__textarea"
              id="message"
              name="message"
              rows="5"
              placeholder="What do you do, who do you serve, and what does your site need? There's no wrong answer."
              required
            ></textarea>
          </div>

          <StyledDropdown
            id="contribution-model"
            name="contribution-model"
            label="Funding preference"
            placeholder="Select one"
            required
            options={[
              { value: 'free-needed', label: 'We need this to be fully free right now.' },
              { value: 'sliding-scale', label: 'We can contribute on a sliding scale.' },
              { value: 'budget', label: 'We have a real budget and are happy to contribute.' },
              { value: 'not-sure', label: 'Not sure yet.' },
              { value: 'designer', label: 'I am a designer interested in collaborating', separatorBefore: true },
            ]}
          />

          <button type="submit" class="btn btn--primary" data-contact-submit>
            <span data-contact-submit-label>Send</span>
            <Send class="btn__icon" aria-hidden="true" size={18} stroke-width={2} />
          </button>
        </form>

        <div class="contact-thanks" data-contact-thanks role="status" aria-live="polite" tabindex="-1" hidden>
          <p class="contact-notice contact-notice--success">
            Thanks for reaching out. If it feels like a good fit, I will respond within a day or two. I try to reply to everyone, but requests are high and I cannot always respond to every message.
          </p>
        </div>

        {
          turnstileSiteKey && (
            <div class="contact-turnstile-row" data-contact-turnstile-row data-reveal>
              <div class="field">
                <div data-contact-turnstile data-sitekey={turnstileSiteKey}></div>
              </div>
            </div>
          )
        }
      </div>

      <div class="contact-steps">
        <p class="eyebrow" data-reveal>how it works</p>
        <ol class="steps" role="list" data-reveal-stagger>
          <li class="step">
            <span class="step__number" aria-hidden="true">01</span>
            <div class="step__content">
              <h3 class="step__title">Tell me about your work</h3>
              <p class="step__body">Fill out the form. Tell me what you do, who you serve, and what you need. No RFP required.</p>
            </div>
          </li>
          <li class="step">
            <span class="step__number" aria-hidden="true">02</span>
            <div class="step__content">
              <h3 class="step__title">We figure out the vision together</h3>
              <p class="step__body">We talk. What does your web presence want to be? What story does it need to tell? I help you find that before a single line of code.</p>
            </div>
          </li>
          <li class="step">
            <span class="step__number" aria-hidden="true">03</span>
            <div class="step__content">
              <h3 class="step__title">I build it</h3>
              <p class="step__body">Fully custom. Accessible. Fast. Made to last. You get final say on everything.</p>
            </div>
          </li>
          <li class="step">
            <span class="step__number" aria-hidden="true">04</span>
            <div class="step__content">
              <h3 class="step__title">You own it outright</h3>
              <p class="step__body">No lock-in. No recurring platform fees. No asking permission to update your own homepage. Just a website that belongs to you.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>

    <div class="contact-closer" data-reveal>
      <aside class="caveat">
        <p>
          I take projects based on availability and whether the work excites me.
          I can't take everything - but I read every message.
        </p>
      </aside>

      <ul class="contact-links" role="list" aria-label="Other ways to get in touch">
        <li>
          <a href={blueskyUrl} target="_blank" rel="noopener noreferrer">
            <BlueskyIcon size={16} />
            Bluesky
          </a>
        </li>
        <li>
          <a href={`mailto:${contactEmail}`}>
            <Mail size={16} stroke-width={2} aria-hidden="true" />
            {contactEmail}
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

{
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    ></script>
  )
}

<script is:inline>
  (() => {
    const form = document.querySelector('[data-contact-form]');
    const formCard = form?.closest('.contact-form-card');
    const startedAtInput = document.querySelector('[data-contact-started-at]');
    const errorNotice = form?.querySelector('[data-contact-notice="error"]');
    const thanksPanel = document.querySelector('[data-contact-thanks]');
    const submitButton = form?.querySelector('[data-contact-submit]');
    const submitLabel = form?.querySelector('[data-contact-submit-label]');
    const turnstileContainer = document.querySelector('[data-contact-turnstile]');
    const turnstileRow = document.querySelector('[data-contact-turnstile-row]');
    const turnstileTokenInput = form?.querySelector('[data-contact-turnstile-token]');
    const isLocalSubmitMock =
      window.location.hostname === 'localhost' ||
      window.location.hostname === '127.0.0.1';
    let turnstileWidgetId = null;
    let turnstileLoadAttempts = 0;
    const maxTurnstileLoadAttempts = 60;
    const turnstileLoadRetryMs = 150;
    let hasTurnstileError = false;

    const loadTurnstileWidget = () => {
      if (!(turnstileContainer instanceof HTMLElement)) {
        return;
      }

      const siteKey = turnstileContainer.dataset.sitekey;
      if (!siteKey) {
        return;
      }

      const turnstileApi = window.turnstile;

      if (!turnstileApi || typeof turnstileApi.render !== 'function') {
        turnstileLoadAttempts += 1;
        if (turnstileLoadAttempts > maxTurnstileLoadAttempts) {
          hasTurnstileError = true;
          return;
        }

        window.setTimeout(loadTurnstileWidget, turnstileLoadRetryMs);
        return;
      }

      if (turnstileWidgetId !== null) {
        return;
      }

      turnstileWidgetId = turnstileApi.render(turnstileContainer, {
        sitekey: siteKey,
        retry: 'never',
        'refresh-expired': 'manual',
        'refresh-timeout': 'manual',
        callback: (token) => {
          if (turnstileTokenInput instanceof HTMLInputElement) {
            turnstileTokenInput.value = typeof token === 'string' ? token : '';
          }

          hasTurnstileError = false;
        },
        'error-callback': () => {
          if (turnstileTokenInput instanceof HTMLInputElement) {
            turnstileTokenInput.value = '';
          }

          hasTurnstileError = true;
        },
      });
    };

    const resetTurnstileWidget = () => {
      if (turnstileWidgetId === null) {
        return;
      }

      const turnstileApi = window.turnstile;
      if (!turnstileApi || typeof turnstileApi.reset !== 'function') {
        return;
      }

      if (turnstileTokenInput instanceof HTMLInputElement) {
        turnstileTokenInput.value = '';
      }

      hasTurnstileError = false;
      turnstileApi.reset(turnstileWidgetId);
    };

    const hasTurnstileToken = () => {
      if (!(turnstileTokenInput instanceof HTMLInputElement)) {
        return false;
      }

      return Boolean(turnstileTokenInput.value);
    };

    const setStartedAt = () => {
      if (startedAtInput instanceof HTMLInputElement) {
        startedAtInput.value = String(Date.now());
      }
    };

    const hideError = () => {
      errorNotice?.setAttribute('hidden', '');
    };

    const showError = () => {
      errorNotice?.removeAttribute('hidden');
      if (errorNotice instanceof HTMLElement) {
        errorNotice.focus();
      }
    };

    const showThanks = () => {
      if (form instanceof HTMLElement) {
        form.hidden = true;
      }

      if (turnstileRow instanceof HTMLElement) {
        turnstileRow.hidden = true;
      }

      if (formCard instanceof HTMLElement) {
        formCard.classList.add('is-complete');
      }

      if (thanksPanel instanceof HTMLElement) {
        thanksPanel.removeAttribute('hidden');
        thanksPanel.focus();
      }
    };

    const setSubmittingState = (isSubmitting) => {
      if (form instanceof HTMLElement) {
        form.setAttribute('aria-busy', isSubmitting ? 'true' : 'false');
      }

      if (formCard instanceof HTMLElement) {
        formCard.classList.toggle('is-submitting', isSubmitting);
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = isSubmitting;
      }

      if (submitLabel instanceof HTMLElement) {
        submitLabel.textContent = isSubmitting ? 'Sending...' : 'Send';
      }
    };

    setStartedAt();
    loadTurnstileWidget();

    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    const status = new URLSearchParams(window.location.search).get('contact');
    if (status === 'sent') {
      showThanks();
      return;
    }

    if (status === 'error') {
      showError();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      hideError();

      if (!isLocalSubmitMock && turnstileContainer instanceof HTMLElement) {
        if (hasTurnstileError || !hasTurnstileToken()) {
          resetTurnstileWidget();
          showError();
          return;
        }
      }

      setSubmittingState(true);

      try {
        if (isLocalSubmitMock) {
          await new Promise((resolve) => setTimeout(resolve, 600));
          form.reset();
          setStartedAt();
          resetTurnstileWidget();
          showThanks();
          return;
        }

        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            Accept: 'application/json',
            'x-contact-ajax': '1',
          },
        });

        if (!response.ok) {
          resetTurnstileWidget();
          showError();
          return;
        }

        const data = await response.json();
        if (!data?.ok) {
          resetTurnstileWidget();
          showError();
          return;
        }

        form.reset();
        setStartedAt();
        resetTurnstileWidget();
        showThanks();
      } catch {
        resetTurnstileWidget();
        showError();
      } finally {
        setSubmittingState(false);
      }
    });
  })();
</script>
