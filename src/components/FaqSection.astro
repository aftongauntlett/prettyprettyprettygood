---
import type { FaqItem, FaqCallout } from '../content/home-data';

interface Props {
  faqs: FaqItem[];
  callout?: FaqCallout;
}

const { faqs, callout }: Props = Astro.props;

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: Array.isArray(faq.a) ? faq.a.join(' ') : faq.a,
    },
  })),
};
---

<section class="section section--raised" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="eyebrow">questions & answers</p>
      <h2 id="faq-heading">Things people usually ask.</h2>
      <p class="section-lead">
        No fine print, no surprises. Here's how this all works.
      </p>
    </div>
    <div class="faq-layout">
      <div class="faq-content">
        <ul class="faq-list" role="list" data-reveal-stagger>
          {faqs.map((faq) => (
            <li class="faq-item">
              <details class="faq-details">
                <summary class="faq-summary">
                  <span class="faq-summary__text">{faq.q}</span>
                  <span class="faq-summary__icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-answer">
                  {Array.isArray(faq.a) ? faq.a.map((para) => <p set:html={para} />) : <p>{faq.a}</p>}
                  {faq.links && (
                    <div class="faq-donate">
                      {faq.links.map((link) => {
                        const isExternal = /^https?:\/\//.test(link.href);
                        return (
                          <a
                            href={link.href}
                            class="btn btn--support"
                            target={isExternal ? '_blank' : undefined}
                            rel={isExternal ? 'noopener noreferrer' : undefined}
                          >
                            {link.label}
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>
        {callout && (
          <div class="faq-callout" data-reveal>
            <p class="faq-callout__heading">{callout.heading}</p>
            <p class="faq-callout__body">{callout.body}</p>
            <a href={callout.link.href} class="btn btn--support">
              {callout.link.label}
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqStructuredData)} />
</section>
