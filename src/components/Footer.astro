---
// Footer.astro
const year = new Date().getFullYear();
const kofiUrl = import.meta.env.PUBLIC_KOFI_URL;
---

<footer class="site-footer">
  <div class="container">

    <div class="site-footer__body">

      <!-- Brand + nav -->
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="prettyprettyprettygood — home">
          pretty<wbr />pretty<wbr />pretty<wbr />good
        </a>
        <p class="site-footer__tagline">
          Free, custom websites for nonprofits, community orgs, artists, and
          mission-driven people. No templates. No fees. No strings.
        </p>
        <nav class="site-footer__nav" aria-label="Footer navigation">
          <ul role="list">
            <li><a href="/#who">About</a></li>
            <li><a href="/#services">Services</a></li>
            <li><a href="/#work">Work</a></li>
            <li><a href="/#contact">Start a project</a></li>
          </ul>
        </nav>
      </div>

      <!-- Donate -->
      <div class="site-footer__support">
        <h2 class="site-footer__nav-heading">Support this work</h2>
        <p class="site-footer__support-body">
          This service is completely free. If it's useful to you or your community,
          consider helping keep it going.
        </p>
        {kofiUrl && (
          <a
            href={kofiUrl}
            class="site-footer__donate-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            Donate →
          </a>
        )}
      </div>

    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {year} prettyprettyprettygood — volunteer web design for nonprofits &amp; mission-driven orgs.
      </p>
      <p class="site-footer__credit">
        Built with care by{' '}
        <a
          href="https://github.com/aftongauntlett"
          rel="noopener noreferrer"
          target="_blank"
        >Afton Gauntlett</a>.
      </p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-neutral-200);
    background-color: var(--color-surface);
    padding-block-start: var(--space-16);
    padding-block-end: var(--space-8);
  }

  /* ── Main body ── */
  .site-footer__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-block-end: var(--space-10);
    border-bottom: 1px solid var(--color-neutral-200);
    text-align: center;
  }

  .site-footer__body .site-footer__tagline {
    max-width: 100%;
  }

  .site-footer__body .site-footer__nav ul {
    justify-content: center;
  }

  .site-footer__body .site-footer__support {
    align-items: center;
  }

  @media (min-width: 40rem) {
    .site-footer__body {
      grid-template-columns: 1fr 1fr;
      text-align: left;
    }

    .site-footer__body .site-footer__tagline {
      max-width: 26rem;
    }

    .site-footer__body .site-footer__nav ul {
      justify-content: flex-start;
    }

    .site-footer__body .site-footer__support {
      align-items: flex-end;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__body {
      grid-template-columns: 2fr 1.5fr;
    }
  }

  /* ── Brand column ── */
  .site-footer__logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
    margin-block-end: var(--space-4);
  }

  .site-footer__logo:hover {
    color: var(--color-primary-dark);
  }

  .site-footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Nav (horizontal, under brand) ── */
  .site-footer__nav {
    margin-block-start: var(--space-5);
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .site-footer__nav a {
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-footer__nav a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* ── Support / donate column ── */
  .site-footer__nav-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }

  .site-footer__support {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .site-footer__support-body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-block-end: var(--space-5);
  }

  .site-footer__donate-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-on-primary);
    background-color: var(--color-primary);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .site-footer__donate-btn:hover {
    background-color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    color: var(--color-text-on-primary);
  }

  /* ── Bottom bar: copyright + credit ── */
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-6);
  }

  .site-footer__copy,
  .site-footer__credit {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .site-footer__credit a {
    color: var(--color-text-muted);
    text-decoration-thickness: 1px;
  }

  .site-footer__credit a:hover {
    color: var(--color-primary);
  }
</style>

