---
// Footer.astro
import { Lightbulb, LightbulbOff } from '@lucide/astro';
import { primaryNavItems } from '../content/home-data';

const year = new Date().getFullYear();
const kofiUrl =
  import.meta.env.PUBLIC_KOFI_URL?.trim() ||
  'https://ko-fi.com/prettyprettyprettygood';
const paypalUrl = 'https://paypal.me/aftons';
---

<footer class="site-footer">
  <div class="container">

    <div class="site-footer__body">

      <!-- Brand + nav -->
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="prettyprettyprettygood — home">
          pretty<wbr />pretty<wbr />pretty<wbr />good
        </a>
        <p class="site-footer__tagline">
          Custom websites for nonprofits, community orgs, artists, and
          mission-driven people.
        </p>
        <nav class="site-footer__nav" aria-label="Footer navigation">
          <ul role="list">
            {primaryNavItems.map((item) => (
              <li><a href={item.href}>{item.footerLabel ?? item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Donate -->
      <div class="site-footer__support">
        <h2 class="site-footer__nav-heading">support this work</h2>
        <p class="site-footer__support-body">
          No one is turned away for lack of funds. If your project has a budget,
          a contribution helps keep this work sustainable for others.
        </p>
        <div class="site-footer__donate-group">
          <a
            href={kofiUrl}
            class="btn btn--support"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ko-fi
          </a>
          <a
            href={paypalUrl}
            class="btn btn--support"
            target="_blank"
            rel="noopener noreferrer"
          >
            PayPal
          </a>
        </div>
      </div>

    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {year} prettyprettyprettygood — sliding-scale web design for nonprofits &amp; mission-driven orgs.
      </p>
      <div class="site-footer__meta">
        <button
          class="site-footer__theme-toggle"
          type="button"
          data-theme-toggle
          aria-pressed="false"
          aria-label="Switch to dark theme."
        >
          <span class="site-footer__theme-icon" data-theme-icon-on aria-hidden="true" hidden>
            <Lightbulb size={16} stroke-width={2} />
          </span>
          <span class="site-footer__theme-icon" data-theme-icon-off aria-hidden="true">
            <LightbulbOff size={16} stroke-width={2} />
          </span>
        </button>
      </div>
    </div>

  </div>
</footer>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeIconOn = themeToggle?.querySelector<HTMLElement>('[data-theme-icon-on]');
  const themeIconOff = themeToggle?.querySelector<HTMLElement>('[data-theme-icon-off]');
  const root = document.documentElement;
  const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
  const storageKey = 'theme-preference';

  const readStoredTheme = (): 'light' | 'dark' | null => {
    try {
      const stored = localStorage.getItem(storageKey);
      return stored === 'light' || stored === 'dark' ? stored : null;
    } catch (_) {
      return null;
    }
  };

  const resolveActiveTheme = (): 'light' | 'dark' => {
    if (root.dataset.theme === 'light' || root.dataset.theme === 'dark') {
      return root.dataset.theme;
    }

    return themeMedia.matches ? 'dark' : 'light';
  };

  const updateToggleLabel = () => {
    if (!themeToggle) return;

    const activeTheme = resolveActiveTheme();
    const isDarkTheme = activeTheme === 'dark';

    const showOnIcon = isDarkTheme;

    if (themeIconOn) {
      themeIconOn.hidden = !showOnIcon;
    }

    if (themeIconOff) {
      themeIconOff.hidden = showOnIcon;
    }

    themeToggle.setAttribute('aria-pressed', String(isDarkTheme));
    themeToggle.setAttribute(
      'aria-label',
      isDarkTheme
        ? 'Switch to light theme.'
        : 'Switch to dark theme.',
    );
  };

  if (themeToggle) {
    updateToggleLabel();

    themeToggle.addEventListener('click', () => {
      const nextTheme = resolveActiveTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = nextTheme;

      try {
        localStorage.setItem(storageKey, nextTheme);
      } catch (_) {}

      updateToggleLabel();
    });

    themeMedia.addEventListener('change', () => {
      if (!readStoredTheme()) {
        updateToggleLabel();
      }
    });
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--color-neutral-200);
    background-color: var(--color-surface);
    padding-block-start: var(--space-16);
    padding-block-end: var(--space-8);
  }

  /* ── Main body ── */
  .site-footer__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-block-end: var(--space-10);
    border-bottom: 1px solid var(--color-neutral-200);
    text-align: center;
  }

  .site-footer__body .site-footer__tagline {
    max-width: 100%;
  }

  .site-footer__body .site-footer__nav ul {
    justify-content: center;
  }

  .site-footer__body .site-footer__support {
    align-items: center;
  }

  @media (min-width: 40rem) {
    .site-footer__body {
      grid-template-columns: 1fr 1fr;
      text-align: left;
    }

    .site-footer__body .site-footer__tagline {
      max-width: 26rem;
    }

    .site-footer__body .site-footer__nav ul {
      justify-content: flex-start;
    }

    .site-footer__body .site-footer__support {
      align-items: flex-end;
    }
  }

  @media (min-width: 64rem) {
    .site-footer__body {
      grid-template-columns: 2fr 1.5fr;
    }
  }

  /* ── Brand column ── */
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .site-footer__logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
  }

  .site-footer__logo:hover {
    color: var(--color-primary-dark);
  }

  .site-footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Nav (horizontal, under brand) ── */
  .site-footer__nav {}

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .site-footer__nav a {
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .site-footer__nav a:hover {
    color: var(--color-primary);
    text-decoration-thickness: 2px;
  }

  /* ── Support / donate column ── */
  .site-footer__nav-heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-primary);
  }

  .site-footer__support {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-end;
    text-align: right;
  }

  .site-footer__support-body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .site-footer__donate-group {
    display: flex;
    gap: var(--space-3);
  }

  /* ── Bottom bar: copyright + credit ── */
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-6);
  }

  .site-footer__copy {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .site-footer__meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-inline-start: auto;
  }

  .site-footer__theme-toggle {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-md);
    background-color: transparent;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-normal);
    padding: var(--space-2) var(--space-4);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .site-footer__theme-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
    background-color: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  .site-footer__theme-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    color: currentColor;
  }

  .site-footer__theme-icon[hidden] {
    display: none;
  }

  @media (max-width: 40rem) {
    .site-footer__bottom {
      justify-content: space-between;
      text-align: left;
    }

    .site-footer__meta {
      margin-inline-start: auto;
    }
  }

</style>

