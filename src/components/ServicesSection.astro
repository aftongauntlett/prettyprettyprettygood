---
import { Palette, Sparkles, Accessibility, Gamepad2, Search, LayoutGrid } from '@lucide/astro';
import type { ServiceItem } from '../content/home-data';

interface Props {
  services: ServiceItem[];
}

const { services }: Props = Astro.props;

const iconMap = {
  Palette,
  Sparkles,
  Accessibility,
  Gamepad2,
  Search,
  LayoutGrid,
} as const;
---

<section class="section" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="eyebrow">what i build</p>
      <h2 id="services-heading">More than a template with your logo on it.</h2>
      <p class="section-lead">
        Every site is built by hand. No page builders, no themes, no shortcuts.
        The goal is a website that feels like you - not like every other site
        on the same platform.
      </p>
    </div>
    <ul class="service-grid" role="list" data-reveal-stagger>
      {services.map((s) => {
        const Icon = iconMap[s.icon];
        return (
          <li class="service-card">
            <span class="service-card__icon-wrap">
              <Icon size={36} class="service-card__icon" aria-hidden="true" />
            </span>
            <h3 class="service-card__title">{s.title}</h3>
            <p class="service-card__body">{s.body}</p>
            {s.chips && s.chips.length > 0 && (
              <ul class="service-card__chips" role="list" aria-label={`${s.title} highlights`}>
                {s.chips.map((chip) => (
                  <li class="service-card__chip">{chip}</li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>
