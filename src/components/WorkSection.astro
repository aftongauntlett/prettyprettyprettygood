---
import { ExternalLink } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { WorkItem } from '../content/home-data';

interface Props {
  work: WorkItem[];
}

const { work }: Props = Astro.props;
---

<section class="section section--raised" id="work" aria-labelledby="work-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <p class="eyebrow">the work</p>
      <h2 id="work-heading">Recent Projects</h2>
      <p class="section-lead">
        A few recent projects that show the kind of thoughtful, accessible
        sites I build. Take a look at the work and what each one was designed
        to do.
      </p>
    </div>
    <ul class="work-grid" role="list" data-reveal-stagger>
      {work.map((w) => (
        <li>
          {w.demo ? (
            <a
              class="work-card"
              href={w.demo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${w.title} - opens in new tab`}
            >
              <div class="work-card__image-wrap">
                <Image
                  src={w.image}
                  width={1200}
                  height={750}
                  alt={w.imageAlt}
                  class="work-card__image"
                  loading="lazy"
                  decoding="async"
                />
                <div class="work-card__image-overlay" aria-hidden="true">
                  <ExternalLink size={32} class="work-card__overlay-icon" />
                </div>
              </div>
              <div class="work-card__content">
                <div class="work-card__title-row">
                  <h3 class="work-card__title">{w.title}</h3>
                  <span class={`work-card__status work-card__status--${w.status.toLowerCase().replace(/\s+/g, '-')}`}>
                    {w.status}
                  </span>
                </div>
                <p class="work-card__desc">{w.description}</p>
              </div>
            </a>
          ) : (
            <article class="work-card" aria-label={`${w.title} - in development`}>
              <div class="work-card__image-wrap">
                <Image
                  src={w.image}
                  width={1200}
                  height={750}
                  alt={w.imageAlt}
                  class="work-card__image"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="work-card__content">
                <div class="work-card__title-row">
                  <h3 class="work-card__title">{w.title}</h3>
                  <span class={`work-card__status work-card__status--${w.status.toLowerCase().replace(/\s+/g, '-')}`}>
                    {w.status}
                  </span>
                </div>
                <p class="work-card__desc">{w.description}</p>
              </div>
            </article>
          )}
        </li>
      ))}
    </ul>
    <div class="work-more" data-reveal>
      <p class="work-more__label">More coming soon</p>
      <p class="work-more__text">New projects actively in progress. Reach out if you want to be part of the next batch.</p>
    </div>
  </div>
</section>
