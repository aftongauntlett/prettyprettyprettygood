---
import SkipToContent from '../components/SkipToContent.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Reveal animation init: adds .js class and restores motion preference
         before first paint to prevent flash of hidden content. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var savedTheme = localStorage.getItem('theme-preference');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }

        if (localStorage.getItem('motion-preference') === 'reduced') {
          document.documentElement.dataset.motion = 'reduced';
        }
      } catch (_) {}
    </script>
  </head>
  <body>
    <SkipToContent />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Scroll-reveal: IntersectionObserver adds .is-visible to [data-reveal]
         and [data-reveal-stagger] elements as they enter the viewport. -->
    <script is:inline>
      (function () {
        var isReduced = function () {
          return (
            window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            document.documentElement.dataset.motion === 'reduced'
          );
        };

        var targets = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');

        if (!targets.length) return;

        // If reduced motion is already active, skip observer entirely —
        // CSS makes all elements visible without animation.
        if (isReduced()) return;

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                var el = entry.target;
                el.classList.add('is-visible');
                observer.unobserve(el);

                // After all transitions settle, strip the reveal attributes entirely.
                // This removes the CSS transition rules that drove the animation so the
                // element is locked in its natural visible state — nothing can re-play.
                // Budget: 500ms duration + up to 5×80ms stagger + 100ms buffer = 1000ms.
                var isStagger = el.hasAttribute('data-reveal-stagger');
                setTimeout(function () {
                  el.removeAttribute('data-reveal');
                  el.removeAttribute('data-reveal-stagger');
                }, isStagger ? 1000 : 600);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
        );

        targets.forEach(function (el) {
          observer.observe(el);
        });

        // If system preference changes to reduced mid-session, make everything visible.
        window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', function (e) {
          if (e.matches) {
            targets.forEach(function (el) {
              el.classList.add('is-visible');
              el.removeAttribute('data-reveal');
              el.removeAttribute('data-reveal-stagger');
            });
            observer.disconnect();
          }
        });
      })();
    </script>
  </body>
</html>
