---
import BaseLayout from '../layouts/BaseLayout.astro';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = `https://formspree.io/f/${formspreeId}`;
---

<BaseLayout
  title="prettyprettyprettygood"
  description="Volunteer web design for nonprofits and mission-driven organizations."
>
  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">volunteer web design</p>
      <h1 class="hero__heading">
        Good design for<br />good causes.
      </h1>
      <p class="hero__body">
        Free, thoughtful web design for nonprofits and mission-driven
        organizations. Every site is built by hand, with care — no templates,
        no shortcuts.
      </p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary">Get in touch</a>
        <a href="#work" class="btn btn--ghost">See the work</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STYLE PREVIEW — Typography
  ═══════════════════════════════════════════════════════════════ -->
  <section class="preview-section" id="work">
    <div class="container">
      <h2 class="preview-section__title">Typography</h2>

      <div class="type-scale">
        <div class="type-row">
          <span class="type-label">--text-5xl / display</span>
          <p class="type-specimen type-specimen--5xl">The quick brown fox</p>
        </div>
        <div class="type-row">
          <span class="type-label">--text-4xl / h1</span>
          <p class="type-specimen type-specimen--4xl">The quick brown fox</p>
        </div>
        <div class="type-row">
          <span class="type-label">--text-3xl / h2</span>
          <p class="type-specimen type-specimen--3xl">The quick brown fox</p>
        </div>
        <div class="type-row">
          <span class="type-label">--text-2xl / h3</span>
          <p class="type-specimen type-specimen--2xl">The quick brown fox</p>
        </div>
        <div class="type-row">
          <span class="type-label">--text-xl / h4</span>
          <p class="type-specimen type-specimen--xl">The quick brown fox</p>
        </div>
        <div class="type-row">
          <span class="type-label">--text-lg / lead</span>
          <p class="type-specimen type-specimen--lg">The quick brown fox jumps over the lazy dog</p>
        </div>
        <div class="type-row">
          <span class="type-label">--text-base / body</span>
          <p class="type-specimen type-specimen--base">The quick brown fox jumps over the lazy dog. Warm, genuine, intentional — that's the goal with every pixel we place.</p>
        </div>
        <div class="type-row">
          <span class="type-label">--text-sm / small</span>
          <p class="type-specimen type-specimen--sm">The quick brown fox jumps over the lazy dog. Used for captions, labels, and meta text.</p>
        </div>
        <div class="type-row">
          <span class="type-label">--font-mono / code</span>
          <code class="type-specimen type-specimen--mono">const warmth = 'intentional';</code>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STYLE PREVIEW — Color Palette
  ═══════════════════════════════════════════════════════════════ -->
  <section class="preview-section preview-section--raised">
    <div class="container">
      <h2 class="preview-section__title">Color Palette</h2>

      <div class="swatch-group">
        <h3 class="swatch-group__heading">Brand</h3>
        <div class="swatch-row">
          <div class="swatch" style="background:var(--color-primary)"><span>primary</span></div>
          <div class="swatch" style="background:var(--color-primary-light)"><span>primary-light</span></div>
          <div class="swatch" style="background:var(--color-primary-dark)"><span>primary-dark</span></div>
          <div class="swatch" style="background:var(--color-accent)"><span>accent</span></div>
          <div class="swatch" style="background:var(--color-accent-light)"><span>accent-light</span></div>
          <div class="swatch" style="background:var(--color-accent-dark)"><span>accent-dark</span></div>
        </div>
      </div>

      <div class="swatch-group">
        <h3 class="swatch-group__heading">Neutral</h3>
        <div class="swatch-row">
          <div class="swatch" style="background:var(--color-neutral-50)"><span class="dark">50</span></div>
          <div class="swatch" style="background:var(--color-neutral-100)"><span class="dark">100</span></div>
          <div class="swatch" style="background:var(--color-neutral-200)"><span class="dark">200</span></div>
          <div class="swatch" style="background:var(--color-neutral-300)"><span class="dark">300</span></div>
          <div class="swatch" style="background:var(--color-neutral-400)"><span>400</span></div>
          <div class="swatch" style="background:var(--color-neutral-500)"><span>500</span></div>
          <div class="swatch" style="background:var(--color-neutral-600)"><span>600</span></div>
          <div class="swatch" style="background:var(--color-neutral-700)"><span>700</span></div>
          <div class="swatch" style="background:var(--color-neutral-800)"><span>800</span></div>
          <div class="swatch" style="background:var(--color-neutral-900)"><span>900</span></div>
        </div>
      </div>

      <div class="swatch-group">
        <h3 class="swatch-group__heading">Semantic</h3>
        <div class="swatch-row">
          <div class="swatch" style="background:var(--color-surface)"><span class="dark">surface</span></div>
          <div class="swatch" style="background:var(--color-surface-raised)"><span class="dark">raised</span></div>
          <div class="swatch" style="background:var(--color-surface-overlay)"><span class="dark">overlay</span></div>
          <div class="swatch" style="background:var(--color-error)"><span>error</span></div>
          <div class="swatch" style="background:var(--color-success)"><span>success</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STYLE PREVIEW — Buttons & Interactive Elements
  ═══════════════════════════════════════════════════════════════ -->
  <section class="preview-section" id="about">
    <div class="container">
      <h2 class="preview-section__title">Buttons &amp; Interactive</h2>

      <div class="preview-row">
        <a href="#" class="btn btn--primary">Primary</a>
        <a href="#" class="btn btn--secondary">Secondary</a>
        <a href="#" class="btn btn--ghost">Ghost</a>
        <button class="btn btn--primary" disabled>Disabled</button>
      </div>

      <h3 class="preview-subsection-title">Form elements</h3>
      <form class="preview-form" action={formAction} method="POST">
        <input type="hidden" name="_subject" value="New message — prettyprettyprettygood" />
        <div class="field">
          <label class="field__label" for="name">Your name</label>
          <input class="field__input" type="text" id="name" name="name" placeholder="Afton Gauntlett" autocomplete="name" />
        </div>
        <div class="field">
          <label class="field__label" for="email">Email address</label>
          <input class="field__input" type="email" id="email" name="email" placeholder="hello@example.com" autocomplete="email" />
        </div>
        <div class="field">
          <label class="field__label" for="org">Organization</label>
          <input class="field__input" type="text" id="org" name="org" placeholder="Nonprofit or mission-driven org" />
        </div>
        <div class="field">
          <label class="field__label" for="message">Tell me about your organization</label>
          <textarea class="field__input field__textarea" id="message" name="message" rows="4" placeholder="What do you do, who do you serve, and what does your site need?"></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Send message</button>
      </form>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STYLE PREVIEW — Cards & Surfaces
  ═══════════════════════════════════════════════════════════════ -->
  <section class="preview-section preview-section--raised" id="contact">
    <div class="container">
      <h2 class="preview-section__title">Cards &amp; Surfaces</h2>
      <div class="card-grid">
        <article class="card">
          <div class="card__badge">Nonprofit</div>
          <h3 class="card__title">Community Food Bank</h3>
          <p class="card__body">A volunteer-built site for a local food bank serving 3,000 families a month. Clean, accessible, and easy to update.</p>
          <a href="#" class="card__link">View project →</a>
        </article>
        <article class="card">
          <div class="card__badge">Education</div>
          <h3 class="card__title">Youth Arts Initiative</h3>
          <p class="card__body">Redesigned branding and web presence for an arts program that gives free lessons to kids in under-resourced schools.</p>
          <a href="#" class="card__link">View project →</a>
        </article>
        <article class="card">
          <div class="card__badge">Advocacy</div>
          <h3 class="card__title">Clean River Coalition</h3>
          <p class="card__body">A fast, SEO-optimized site that helps the coalition grow its volunteer base and attract grant funding.</p>
          <a href="#" class="card__link">View project →</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    padding-block: var(--space-16);
    background-color: var(--color-surface);
  }

  .hero__inner {
    max-width: 44rem;
  }

  .hero__eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent-dark);
    margin-bottom: var(--space-4);
  }

  .hero__heading {
    font-size: var(--text-5xl);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .hero__body {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* ── Buttons ──────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    border-radius: var(--radius-md);
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .btn--primary {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    border-color: var(--color-primary);
  }

  .btn--primary:hover {
    background-color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    color: var(--color-text-on-primary);
  }

  .btn--secondary {
    background-color: var(--color-surface-raised);
    color: var(--color-primary);
    border-color: var(--color-neutral-300);
  }

  .btn--secondary:hover {
    border-color: var(--color-primary);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-primary);
    border-color: transparent;
  }

  .btn--ghost:hover {
    background-color: var(--color-surface-raised);
  }

  .btn:disabled,
  .btn[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* ── Preview Sections ────────────────────────────────── */
  .preview-section {
    padding-block: var(--space-16);
  }

  .preview-section--raised {
    background-color: var(--color-surface-raised);
  }

  .preview-section__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-neutral-200);
  }

  .preview-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .preview-subsection-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  /* ── Type Scale ──────────────────────────────────────── */
  .type-scale {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .type-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-neutral-100);
  }

  .type-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-top: var(--space-1);
  }

  .type-specimen { font-family: var(--font-body); }
  .type-specimen--5xl  { font-family: var(--font-display); font-size: var(--text-5xl); font-weight: var(--font-weight-bold); line-height: var(--leading-tight); }
  .type-specimen--4xl  { font-family: var(--font-display); font-size: var(--text-4xl); font-weight: var(--font-weight-bold); line-height: var(--leading-tight); }
  .type-specimen--3xl  { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: var(--font-weight-bold); }
  .type-specimen--2xl  { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: var(--font-weight-bold); }
  .type-specimen--xl   { font-size: var(--text-xl); }
  .type-specimen--lg   { font-size: var(--text-lg); color: var(--color-text-muted); }
  .type-specimen--base { font-size: var(--text-base); line-height: var(--leading-relaxed); }
  .type-specimen--sm   { font-size: var(--text-sm); color: var(--color-text-muted); }
  .type-specimen--mono { font-family: var(--font-mono); font-size: var(--text-sm); background: var(--color-surface-overlay); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); }

  /* ── Color Swatches ──────────────────────────────────── */
  .swatch-group {
    margin-bottom: var(--space-8);
  }

  .swatch-group__heading {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .swatch-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .swatch {
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: flex-end;
    padding: var(--space-2);
    border: 1px solid rgb(0 0 0 / 0.06);
  }

  .swatch span {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-neutral-50);
    line-height: 1.2;
  }

  .swatch span.dark {
    color: var(--color-neutral-800);
  }

  /* ── Form ────────────────────────────────────────────── */
  .preview-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 36rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .field__input {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-base);
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 1.5px solid var(--color-neutral-300);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .field__input::placeholder {
    color: var(--color-neutral-400);
  }

  .field__input:hover {
    border-color: var(--color-neutral-400);
  }

  .field__input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .field__textarea {
    resize: vertical;
    min-height: 8rem;
  }

  /* ── Cards ───────────────────────────────────────────── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .card__badge {
    display: inline-flex;
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent-dark);
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    border-radius: var(--radius-full);
  }

  .card__title {
    font-size: var(--text-xl);
  }

  .card__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .card__link {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    align-self: flex-start;
  }

  .card__link:hover {
    color: var(--color-primary-dark);
  }
</style>

