---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Palette, Sparkles, Accessibility, Gamepad2, Search, LayoutGrid, ExternalLink } from '@lucide/astro';
import { Image } from 'astro:assets';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = `https://formspree.io/f/${formspreeId}`;

const whoIWorkWith = [
  {
    label: 'Community & Cause',
    items: ['Nonprofits', 'Civic Orgs', 'Animal Welfare', 'Intentional Communities', 'Fan Communities'],
  },
  {
    label: 'Arts & Culture',
    items: ['Musicians', 'Artists', 'Museums', 'Game Studios'],
  },
  {
    label: 'Care & Craft',
    items: ['Therapists', 'Herbalists', 'Farmers Markets', 'Co-ops'],
  },
];

const services = [
  {
    icon: Palette,
    title: 'Custom Static Sites',
    body: 'Fast, accessible, built to last. No monthly fees, no CMS lock-in — just a site you own outright.',
  },
  {
    icon: Sparkles,
    title: 'Animation & Motion',
    body: 'Personality-forward design with thoughtful motion. Delightful, not distracting — and always with a no-motion fallback.',
  },
  {
    icon: Accessibility,
    title: 'Accessibility-First',
    body: 'WCAG 2.2 AA as the floor, AAA where practical. Clear UI, keyboard navigation, and semantic HTML for everyone.',
  },
  {
    icon: Gamepad2,
    title: 'Browser-Based Games',
    body: 'Your website can be a game. Interactive experiences, playful interfaces, or a full-blown browser game — all of the above.',
  },
  {
    icon: Search,
    title: 'Finding Your Vision',
    body: "Don't know what you need yet? That's fine — the best part. We figure out what your web presence could be, then build it.",
  },
  {
    icon: LayoutGrid,
    title: 'Off Paid Platforms',
    body: 'Migrating you off WordPress, Squarespace, or anything else charging you monthly for things you should just own.',
  },
];

const work = [
  {
    title: 'No Whiteboard Dashboard',
    status: 'In Production',
    description:
      'A frontend dashboard built on the open-source Hiring Without Whiteboards dataset, turning a large markdown company list into a fast, searchable web experience. Includes full-text search, multi-filtering, card and list view modes, pagination, dark and light themes, and mobile-first navigation.',
    tech: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vercel'],
    link: 'https://github.com/aftongauntlett/no-whiteboard-jobs-dashboard',
    demo: 'https://no-wb.org',
    image: '/images/no-wb.png',
    imageAlt: 'Screenshot of the No Whiteboard Jobs Dashboard showing a searchable list of tech companies that don\'t whiteboard in interviews',
  },
  {
    title: 'Astrid Beauty Hair Salon',
    status: 'In Production',
    description:
      'A production website for Astrid Beauty Salon, originally hand-built for a client with real customers. Rebuilt in 2026 as a full refactor and redesign. Focused on clear service presentation, pricing guidance, and a low-friction path to booking — with accessible markup and SEO-friendly structure throughout.',
    tech: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vercel'],
    link: 'https://github.com/aftongauntlett/astrid-beauty',
    demo: 'https://www.byastridbeautysalon.com/',
    image: '/images/astrid.png',
    imageAlt: 'Screenshot of the Astrid Beauty Hair Salon website showing service listings and booking information',
  },
  {
    title: 'Ghostbusters Virginia',
    status: 'In Development',
    description:
      'A community-focused website for Ghostbusters Virginia, refactored into a modern Astro site. Includes event listings, curated image galleries with a lightbox, news and media pages, and an integrated contact and booking flow. Prioritizes accessibility, SEO-friendly structure, and mobile-first performance.',
    tech: ['Astro', 'TypeScript', 'Keystatic', 'Vercel'],
    link: 'https://github.com/aftongauntlett/ghostbustersva',
    demo: '',
    image: '/images/gbva.png',
    imageAlt: 'Screenshot of the Ghostbusters Virginia community website showing event listings and team information',
  },
];
---

<BaseLayout
  title="prettyprettyprettygood — free web design for good people"
  description="Free, custom websites for nonprofits, community orgs, artists, and mission-driven people. No templates, no monthly fees, no WordPress."
>

  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow">free web design · by afton</p>
        <h1 class="hero__heading">
          Your work is good.<br />
          Your website<br />
          should be too.
        </h1>
        <p class="hero__body">
          I build free, custom websites for nonprofits, community orgs, artists,
          and mission-driven people. No templates, no monthly fees, no WordPress —
          just a thoughtful site you own outright.
        </p>
        <div class="hero__actions">
          <a href="#work" class="btn btn--secondary">See the work</a>
          <a href="#contact" class="btn btn--primary">Start a project</a>
        </div>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <canvas id="hero-canvas" class="hero__canvas"></canvas>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       WHO I WORK WITH
  ═══════════════════════════════════════════════════════════════ -->
  <section class="section section--raised" id="who" aria-labelledby="who-heading">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">who this is for</p>
        <h2 id="who-heading">If this sounds like you, let's talk.</h2>
        <p class="section-lead">
          I work with people doing good work — not people trying to extract
          maximum profit. If you're building something that matters to a community,
          a cause, or a creative life, this is for you.
        </p>
      </div>
      <dl class="who-groups">
        {whoIWorkWith.map((group) => (
          <div class="who-group">
            <dt class="who-group__label">{group.label}</dt>
            <dd class="who-group__tags">
              <ul class="tag-grid" role="list">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SERVICES
  ═══════════════════════════════════════════════════════════════ -->
  <section class="section" id="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">what i build</p>
        <h2 id="services-heading">More than a template with your logo on it.</h2>
        <p class="section-lead">
          Every site is built by hand. No page builders, no themes, no shortcuts.
          The goal is a website that feels like you — not like every other site
          on the same platform.
        </p>
      </div>
      <ul class="service-grid" role="list">
        {services.map((s) => (
          <li class="service-card">
            <s.icon size={28} class="service-card__icon" aria-hidden="true" />
            <div>
              <h3 class="service-card__title">{s.title}</h3>
              <p class="service-card__body">{s.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       HOW IT WORKS
  ═══════════════════════════════════════════════════════════════ -->
  <section class="section section--raised" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">how it works</p>
        <h2 id="how-heading">No pitch decks. No retainers. No nonsense.</h2>
      </div>
      <ol class="steps" role="list">
        <li class="step">
          <span class="step__number" aria-hidden="true">01</span>
          <div class="step__content">
            <h3 class="step__title">Tell me about your work</h3>
            <p class="step__body">Fill out the form below. Tell me what you do, who you serve, and what you need. No RFP required.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__number" aria-hidden="true">02</span>
          <div class="step__content">
            <h3 class="step__title">We figure out the vision</h3>
            <p class="step__body">We talk. What does your web presence want to be? What story does it need to tell? I help you find that before I write a single line of code.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__number" aria-hidden="true">03</span>
          <div class="step__content">
            <h3 class="step__title">I build it</h3>
            <p class="step__body">Fully custom. Accessible. Fast. Made to last. You get final say on everything.</p>
          </div>
        </li>
        <li class="step">
          <span class="step__number" aria-hidden="true">04</span>
          <div class="step__content">
            <h3 class="step__title">You own it — for free</h3>
            <p class="step__body">No invoices. No recurring fees. No asking permission to update your own homepage. Just a website that belongs to you.</p>
          </div>
        </li>
      </ol>

      <aside class="caveat">
        <p>
          I take projects based on my availability and whether the work genuinely
          excites me. I can't take everything — but I read every message.
        </p>
      </aside>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       WORK
  ═══════════════════════════════════════════════════════════════ -->
  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">the work</p>
        <h2 id="work-heading">See my work</h2>
        <p class="section-lead">
          Hand-built, accessible, and free to own. Simple to use for the people
          who need it, and made to last without a monthly bill attached.
        </p>
      </div>
      <ul class="work-grid" role="list">
        {work.map((w) => (
          <li>
            <a
              class="work-card"
              href={w.demo || w.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${w.title} — opens in new tab`}
            >
              <div class="work-card__image-wrap">
                <Image
                  src={w.image}
                  width={1200}
                  height={750}
                  alt={w.imageAlt}
                  class="work-card__image"
                  loading="lazy"
                  decoding="async"
                />
                <div class="work-card__image-overlay" aria-hidden="true">
                  <ExternalLink size={32} class="work-card__overlay-icon" />
                </div>
              </div>
              <div class="work-card__content">
                <div class="work-card__title-row">
                  <h3 class="work-card__title">{w.title}</h3>
                  <span class={`work-card__status work-card__status--${w.status.toLowerCase().replace(/\s+/g, '-')}`}>
                    {w.status}
                  </span>
                </div>
                <p class="work-card__desc">{w.description}</p>
                <ul class="work-card__tech tag-grid" role="list">
                  {w.tech.map((t) => <li class="tag">{t}</li>)}
                </ul>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CONTACT
  ═══════════════════════════════════════════════════════════════ -->
  <section class="section section--raised" id="contact" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">start a project</p>
        <h2 id="contact-heading">Tell me what you're building.</h2>
        <p class="section-lead">
          Don't overthink it. A few sentences about who you are and what you need
          is plenty. I'll follow up if it's a good fit.
        </p>
      </div>

      <form class="contact-form" action={formAction} method="POST">
        <input type="hidden" name="_subject" value="New project inquiry — prettyprettyprettygood" />

        <div class="field">
          <label class="field__label" for="name">Your name</label>
          <input class="field__input" type="text" id="name" name="name"
            placeholder="What should I call you?" autocomplete="name" required />
        </div>

        <div class="field">
          <label class="field__label" for="email">Email address</label>
          <input class="field__input" type="email" id="email" name="email"
            placeholder="Where should I write back?" autocomplete="email" required />
        </div>

        <div class="field">
          <label class="field__label" for="org">
            Organization or project
            <span class="field__hint">(optional)</span>
          </label>
          <input class="field__input" type="text" id="org" name="org"
            placeholder="Your org, band, co-op, studio…" />
        </div>

        <div class="field">
          <label class="field__label" for="message">Tell me about your work</label>
          <textarea class="field__input field__textarea" id="message" name="message"
            rows="5"
            placeholder="What do you do, who do you serve, and what does your site need? There's no wrong answer."
            required></textarea>
        </div>

        <div class="field">
          <label class="field__label" for="existing-site">
            Existing website
            <span class="field__hint">(if you have one)</span>
          </label>
          <input class="field__input" type="url" id="existing-site" name="existing-site"
            placeholder="https://" autocomplete="url" />
        </div>

        <button type="submit" class="btn btn--primary">Send it →</button>
      </form>
    </div>
  </section>

</BaseLayout>

<script>
  // Hero canvas — fluid push physics.
  // Cursor velocity drives a directional drag force so particles get swept
  // in the direction of travel (not just radially away). Spring pulls home gently.
  // ~25% of particles are hollow rings for visual variety.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;

  if (canvas && !prefersReduced) {
    const ctx = canvas.getContext('2d')!;

    const cssVars = getComputedStyle(document.documentElement);
    const colors = [
      cssVars.getPropertyValue('--color-primary').trim()       || '#8b5e3c',
      cssVars.getPropertyValue('--color-primary-light').trim() || '#b07d56',
      cssVars.getPropertyValue('--color-accent').trim()        || '#c8973c',
      cssVars.getPropertyValue('--color-accent-light').trim()  || '#e0b86a',
      cssVars.getPropertyValue('--color-neutral-300').trim()   || '#d4c5b0',
      cssVars.getPropertyValue('--color-neutral-400').trim()   || '#b8a48c',
    ];

    let CW = 0, CH = 0;
    let mx = -9999, my = -9999;
    let prevMx = -9999, prevMy = -9999;
    // Smoothed cursor velocity
    let cvx = 0, cvy = 0;

    // ── Tuning ──────────────────────────────────────────────
    const PARTICLE_COUNT = 78;
    const REPEL_RADIUS   = 100;  // px — influence zone around cursor
    const REPEL_FORCE    = 0.42; // radial push strength
    const DRAG_FORCE     = 0.18; // directional sweep strength (the "push" feel)
    const SPRING_K       = 0.010; // spring home strength — softer = less orbiting
    const FRICTION       = 0.84;  // velocity damping — lower = settles quicker
    const MAX_SPEED      = 5.0;
    const VEL_SMOOTH     = 0.35;  // cursor velocity smoothing (0=instant, 1=frozen)
    // ────────────────────────────────────────────────────────

    type Shape = 'circle' | 'ring';

    interface Particle {
      x: number; y: number;
      hx: number; hy: number;
      vx: number; vy: number;
      r: number;
      lw: number;         // stroke width for rings
      color: string;
      alpha: number;
      shape: Shape;
      phase: number;      // idle breathing phase offset
      breatheAmp: number; // idle oscillation amplitude (px)
    }

    const particles: Particle[] = [];

    function makeParticle(hx: number, hy: number): Particle {
      const isRing = Math.random() < 0.28;
      return {
        x: hx, y: hy, hx, hy,
        vx:         rand(-0.3, 0.3),
        vy:         rand(-0.25, 0.25),
        r:          isRing ? rand(5, 13) : rand(2.5, 9),
        lw:         rand(1, 2.5),
        color:      colors[Math.floor(Math.random() * colors.length)],
        alpha:      isRing ? rand(0.18, 0.45) : rand(0.14, 0.55),
        shape:      isRing ? 'ring' : 'circle',
        phase:      Math.random() * Math.PI * 2,
        breatheAmp: rand(4, 12),
      };
    }

    // Random placement — naturally covers corners, no grid bias
    function randomHomes(): [number, number][] {
      const pad = 8;
      return Array.from({ length: PARTICLE_COUNT }, () => [
        rand(pad, CW - pad),
        rand(pad, CH - pad),
      ]);
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      CW = rect.width;
      CH = rect.height;
      canvas!.width  = CW * devicePixelRatio;
      canvas!.height = CH * devicePixelRatio;
      ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    }

    function update() {
      const now = performance.now() * 0.001;
      // ── Smooth cursor velocity ──
      if (mx > -9990 && prevMx > -9990) {
        cvx = cvx * (1 - VEL_SMOOTH) + (mx - prevMx) * VEL_SMOOTH;
        cvy = cvy * (1 - VEL_SMOOTH) + (my - prevMy) * VEL_SMOOTH;
      } else {
        cvx *= 0.85;
        cvy *= 0.85;
      }
      prevMx = mx;
      prevMy = my;

      for (const p of particles) {
        const dx   = p.x - mx;
        const dy   = p.y - my;
        const dist = Math.hypot(dx, dy);

        if (dist < REPEL_RADIUS && dist > 0) {
          const influence = 1 - dist / REPEL_RADIUS;
          // Radial: push outward from cursor centre
          p.vx += (dx / dist) * influence * REPEL_FORCE;
          p.vy += (dy / dist) * influence * REPEL_FORCE;
          // Directional: sweep in the direction the cursor is actually moving
          p.vx += cvx * influence * DRAG_FORCE;
          p.vy += cvy * influence * DRAG_FORCE;
        }

        // Spring toward breathing home (subtle idle drift)
        const bx = p.hx + Math.sin(now * 0.4  + p.phase)       * p.breatheAmp;
        const by = p.hy + Math.cos(now * 0.31 + p.phase * 1.3) * p.breatheAmp;
        p.vx += (bx - p.x) * SPRING_K;
        p.vy += (by - p.y) * SPRING_K;

        // Friction + speed cap
        p.vx *= FRICTION;
        p.vy *= FRICTION;
        const spd = Math.hypot(p.vx, p.vy);
        if (spd > MAX_SPEED) {
          p.vx = (p.vx / spd) * MAX_SPEED;
          p.vy = (p.vy / spd) * MAX_SPEED;
        }

        p.x += p.vx;
        p.y += p.vy;

        // Soft wall nudge — spring home handles long-range return
        const m = p.r;
        if (p.x < m)      { p.x = m;      p.vx =  Math.abs(p.vx) * 0.4; }
        if (p.x > CW - m) { p.x = CW - m; p.vx = -Math.abs(p.vx) * 0.4; }
        if (p.y < m)      { p.y = m;      p.vy =  Math.abs(p.vy) * 0.4; }
        if (p.y > CH - m) { p.y = CH - m; p.vy = -Math.abs(p.vy) * 0.4; }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, CW, CH);
      for (const p of particles) {
        ctx.globalAlpha = p.alpha;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        if (p.shape === 'ring') {
          ctx.strokeStyle = p.color;
          ctx.lineWidth   = p.lw;
          ctx.stroke();
        } else {
          ctx.fillStyle = p.color;
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    }

    function loop() { update(); draw(); requestAnimationFrame(loop); }

    function init() {
      resize();
      particles.length = 0;
      const homes = randomHomes();
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const [hx, hy] = homes[i];
        particles.push(makeParticle(hx, hy));
      }
      loop();
    }

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas!.getBoundingClientRect();
      mx = e.clientX - rect.left;
      my = e.clientY - rect.top;
    });

    canvas.addEventListener('mouseleave', () => {
      mx = -9999; my = -9999;
      cvx = 0; cvy = 0;
      prevMx = -9999; prevMy = -9999;
    });

    const ro = new ResizeObserver(() => {
      resize();
      const homes = randomHomes();
      particles.forEach((p, i) => {
        p.hx = homes[i][0];
        p.hy = homes[i][1];
        p.x  = Math.min(Math.max(p.x, p.r), CW - p.r);
        p.y  = Math.min(Math.max(p.y, p.r), CH - p.r);
      });
    });
    ro.observe(canvas);

    init();
  }

</script>
<style>
  /* ── Shared section rhythm ────────────────────────────── */
  .section {
    padding-block: var(--space-16);
  }

  .section--raised {
    background-color: var(--color-surface-raised);
  }

  .section-header {
    max-width: 40rem;
    margin-bottom: var(--space-12);
  }

  .section-header h2 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    color: var(--color-neutral-700);
  }

  .section-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent-dark);
    margin-bottom: var(--space-3);
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    padding-block: var(--space-16);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__content {
    max-width: 36rem;
  }

  .hero__visual {
    position: relative;
    height: 28rem;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background-color: var(--color-surface-subtle);
    order: -1;
  }

  .hero__canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__heading {
    font-size: var(--text-5xl);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: var(--tracking-tight);
  }

  .hero__body {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: flex-end;
  }

  /* ── Buttons ──────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-md);
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      color var(--transition-base),
      border-color var(--transition-base);
  }

  .btn--primary {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    border-color: var(--color-primary);
  }

  .btn--primary:hover {
    background-color: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    color: var(--color-text-on-primary);
  }

  .btn--secondary {
    background-color: transparent;
    color: var(--color-accent-dark);
    border-color: var(--color-accent);
  }

